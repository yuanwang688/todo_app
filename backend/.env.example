# Copy to .env and fill in values
# Neon: copy the connection string, change postgresql:// → postgresql+asyncpg://, wrap in quotes
# sslmode=require is supported and handled automatically
DATABASE_URL="postgresql+asyncpg://user:password@host/dbname?sslmode=require"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=   # generate with: openssl rand -hex 32
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
ENVIRONMENT=development

# Todo assistant (Phase B). Leave blank to disable /api/chat with a clear 503.
ANTHROPIC_API_KEY=
# Dev-only: Opus 5 is the production model. Haiku 5.5 costs ~1/50th as much
# per token and supports everything the agent loop uses, so it's the default
# for local work. Leave both unset in production.
ANTHROPIC_MODEL=claude-haiku-5-5
# Point at an Anthropic-compatible local server instead (free, much weaker);
# scripts/dev_up.sh --ollama sets this, the model, and a placeholder key for you.
# ANTHROPIC_BASE_URL=http://localhost:11434
